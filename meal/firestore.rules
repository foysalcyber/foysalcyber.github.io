rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // The admin panel is intentionally read-only and restricted to this exact,
    // verified Firebase Authentication identity. The browser check is only UX;
    // this rule is the authoritative access control.
    function isVerifiedAdmin() {
      return signedIn()
        && request.auth.token.email == 'foysal.cyber@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function validProfile(userId) {
      let data = request.resource.data;
      return owns(userId)
        && data.keys().hasAll(['displayName', 'email', 'updatedAt'])
        && data.keys().hasOnly([
          'displayName',
          'email',
          'roomNo',
          'createdAt',
          'updatedAt',
          'lastSeenAt',
          'lastLoginAt',
          'lastMealActivityAt',
          'sessionCount',
          'mealActionCount',
          'appVersion'
        ])
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 60
        && data.email is string
        && data.email == request.auth.token.email
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && (!data.keys().hasAny(['roomNo'])
          || (data.roomNo is string && data.roomNo.matches('^[0-9]{1,6}$')))
        && (!data.keys().hasAny(['createdAt']) || data.createdAt is timestamp)
        && (!data.keys().hasAny(['lastSeenAt']) || data.lastSeenAt is timestamp)
        && (!data.keys().hasAny(['lastLoginAt']) || data.lastLoginAt is timestamp)
        && (!data.keys().hasAny(['lastMealActivityAt']) || data.lastMealActivityAt is timestamp)
        && (!data.keys().hasAny(['sessionCount'])
          || (data.sessionCount is int && data.sessionCount >= 0))
        && (!data.keys().hasAny(['mealActionCount'])
          || (data.mealActionCount is int && data.mealActionCount >= 0))
        && (!data.keys().hasAny(['appVersion'])
          || (data.appVersion is string && data.appVersion.size() <= 20));
    }

    function validProfileCreate() {
      let data = request.resource.data;
      return (!data.keys().hasAny(['createdAt']) || data.createdAt == request.time)
        && (!data.keys().hasAny(['lastSeenAt']) || data.lastSeenAt == request.time)
        && (!data.keys().hasAny(['lastLoginAt']) || data.lastLoginAt == request.time)
        && (!data.keys().hasAny(['lastMealActivityAt']) || data.lastMealActivityAt == request.time)
        && (!data.keys().hasAny(['sessionCount']) || data.sessionCount <= 1)
        && (!data.keys().hasAny(['mealActionCount']) || data.mealActionCount <= 1);
    }

    function validProfileUpdate() {
      let data = request.resource.data;
      let oldData = resource.data;
      let changed = data.diff(oldData).affectedKeys();
      return changed.hasOnly([
          'displayName',
          'roomNo',
          'updatedAt',
          'lastSeenAt',
          'lastLoginAt',
          'lastMealActivityAt',
          'sessionCount',
          'mealActionCount',
          'appVersion'
        ])
        && (!changed.hasAny(['lastSeenAt']) || data.lastSeenAt == request.time)
        && (!changed.hasAny(['lastLoginAt']) || data.lastLoginAt == request.time)
        && (!changed.hasAny(['lastMealActivityAt']) || data.lastMealActivityAt == request.time)
        && (!changed.hasAny(['sessionCount'])
          || data.sessionCount == oldData.get('sessionCount', 0) + 1)
        && (!changed.hasAny(['mealActionCount'])
          || data.mealActionCount == oldData.get('mealActionCount', 0) + 1);
    }

    function usesCurrentMealRate(monthId) {
      // Tk 55 takes effect in September 2026. Zero-padded month IDs are
      // validated below; this expression covers 2026-09 through 2100-12.
      return monthId.matches('^(2026-(09|1[0-2])|202[7-9]-(0[1-9]|1[0-2])|20[3-9][0-9]-(0[1-9]|1[0-2])|2100-(0[1-9]|1[0-2]))$');
    }

    function expectedMealRatePaisa(monthId) {
      return usesCurrentMealRate(monthId) ? 5500 : 5200;
    }

    function validMonth(monthId) {
      let data = request.resource.data;
      return monthId.matches('^(20[0-9]{2}|2100)-(0[1-9]|1[0-2])$')
        && data.keys().hasAll(['monthKey', 'advancePaisa', 'mealRatePaisa', 'updatedAt'])
        && data.keys().hasOnly(['monthKey', 'advancePaisa', 'mealRatePaisa', 'createdAt', 'updatedAt'])
        && data.monthKey == monthId
        && data.advancePaisa is int
        && data.advancePaisa >= 0
        && data.advancePaisa <= 100000000
        && data.mealRatePaisa is int
        && data.mealRatePaisa == expectedMealRatePaisa(monthId)
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['createdAt']) || data.createdAt is timestamp);
    }

    function validDay(monthId, dateId) {
      let data = request.resource.data;
      return dateId.matches('^(20[0-9]{2}|2100)-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && dateId.matches('^' + monthId + '-(0[1-9]|[12][0-9]|3[01])$')
        && data.keys().hasAll(['dateKey', 'updatedAt'])
        && data.keys().hasOnly(['dateKey', 'breakfast', 'lunch', 'dinner', 'updatedAt'])
        && data.dateKey == dateId
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['breakfast']) || data.breakfast is bool)
        && (!data.keys().hasAny(['lunch']) || data.lunch is bool)
        && (!data.keys().hasAny(['dinner']) || data.dinner is bool);
    }

    match /users/{userId} {
      // Residents can read only themselves. The verified admin can list/read
      // safe profile and usage metadata for the monitoring dashboard.
      allow read: if owns(userId) || isVerifiedAdmin();
      allow create: if validProfile(userId) && validProfileCreate();
      allow update: if validProfile(userId) && validProfileUpdate();
      allow delete: if owns(userId);

      match /months/{monthId} {
        // Individual meal records stay private to the resident. The admin
        // dashboard receives only the profile-level counters above.
        allow read: if owns(userId);
        allow create: if owns(userId) && validMonth(monthId);
        allow update: if owns(userId)
          && validMonth(monthId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['advancePaisa', 'mealRatePaisa', 'updatedAt']);
        allow delete: if owns(userId);

        match /days/{dateId} {
          allow read: if owns(userId);
          allow create: if owns(userId) && validDay(monthId, dateId);
          allow update: if owns(userId)
            && validDay(monthId, dateId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['breakfast', 'lunch', 'dinner', 'updatedAt']);
          allow delete: if owns(userId);
        }
      }
    }
  }
}
